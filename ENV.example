# Copy to a private file outside version control and replace every required placeholder.
MEGATRON_ROOT=/opt/Megatron-LM
# Optional override; the bundled compatibility client is used when unset.
# AZURE_MODAL_PATH=/opt/authorized-azure-modal-client
# AZURE_MODAL_DIR=/opt/authorized-azure-modal-client
HF_CHECKPOINT=/data/checkpoints/qwen35b_hf
REF_LOAD=/data/checkpoints/qwen35b_torch_dist
PROMPT_DATA=/data/prompts/source_repair_train.jsonl
EVAL_PROMPT_DATA=/data/prompts/source_repair_eval.jsonl
RUN_DIR=/data/runs/source_repair

SANDBOX_BASE_URL=https://sandbox.example.invalid
SANDBOX_API_KEY=
WANDB_API_KEY=

# Set to 0 to disable W&B explicitly. The launcher default is 1.
ENABLE_WANDB=0
